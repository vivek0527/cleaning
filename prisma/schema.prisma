// ============================================================
// Sunshine Cleaning Services — Prisma Schema
// ============================================================
// Database: PostgreSQL
// ORM: Prisma
// Status: Schema ready, not yet connected to a database.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------- Customer ----------
model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String
  address   String
  postcode  String
  bookings  Booking[]
  referrals Referral[] @relation("ReferrerRelation")
  referred  Referral[] @relation("ReferredRelation")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------- Service ----------
model Service {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  active      Boolean  @default(true)
  bookings    Booking[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------- Booking ----------
model Booking {
  id               String        @id @default(cuid())
  reference        String        @unique
  customer         Customer      @relation(fields: [customerId], references: [id])
  customerId       String
  service          Service       @relation(fields: [serviceId], references: [id])
  serviceId        String
  propertyType     String
  bedrooms         Int           @default(0)
  bathrooms        Int           @default(0)
  propertySize     String?
  date             DateTime
  time             String
  notes            String?
  status           BookingStatus @default(PENDING)
  referral         Referral?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

enum BookingStatus {
  PENDING
  CONFIRMED
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ---------- Referral ----------
model Referral {
  id              String         @id @default(cuid())
  referrer        Customer       @relation("ReferrerRelation", fields: [referrerId], references: [id])
  referrerId      String
  referred        Customer       @relation("ReferredRelation", fields: [referredId], references: [id])
  referredId      String
  booking         Booking?       @relation(fields: [bookingId], references: [id])
  bookingId       String?        @unique
  reward          String         // Configurable reward text/amount
  status          ReferralStatus @default(PENDING)
  createdAt       DateTime       @default(now())
}

enum ReferralStatus {
  PENDING
  COMPLETED
  EXPIRED
}

// ---------- Enquiry ----------
model Enquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String
  service   String?
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ---------- Testimonial ----------
model Testimonial {
  id           String   @id @default(cuid())
  customerName String
  rating       Int
  review       String
  service      String
  approved     Boolean  @default(false)
  createdAt    DateTime @default(now())
}
